# Copy to .env for local development. Never commit .env.
# Real deployments inject every value via CDK — this file is dev-only.

STAGE=dev
AWS_REGION=us-east-1
SERVICE_NAME=cloud-commerce
LOG_LEVEL=debug
LOG_PRETTY=true

# --- DynamoDB (local) ---
CATALOG_TABLE_NAME=cloud-commerce-catalog-dev
IDEMPOTENCY_TABLE_NAME=cloud-commerce-idempotency-dev
DYNAMODB_ENDPOINT=http://localhost:8000

# --- PostgreSQL (local, docker compose) ---
DATABASE_URL=postgres://commerce:commerce@localhost:5432/commerce

# --- Messaging ---
EVENT_BUS_NAME=cloud-commerce-events-dev

# --- Auth ---
# Leave the Cognito vars empty locally to use the fake verifier + debug claims.
AUTH_ALLOW_DEBUG_CLAIMS=true
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=

# --- Providers ---
PAYMENT_PROVIDER=mock
SHIPPING_PROVIDER=mock
EMAIL_PROVIDER=mock
# Deliberate failure scenario (0..1). 0 = never fail.
PAYMENT_MOCK_FAILURE_RATE=0

# --- HTTP ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
API_RATE_LIMIT_PER_MINUTE=120
